{
  "expo": {
    "name": "PNP EmergencyLink",
    "slug": "kirk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pnpemergencylink",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "PNP EmergencyLink needs your location to identify the nearest available emergency responder and send your emergency location.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "PNP EmergencyLink needs your location to identify the nearest available emergency responder and send your emergency location."
      }
    },
    "android": {
      "package": "com.pnp.emergencylink",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F172A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "PNP EmergencyLink needs your location to identify the nearest available emergency responder and send your emergency location."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "EXPO_PUBLIC_API_URL": "http://192.168.1.148:8000/api",
      "eas": {
        "projectId": "cd584c99-7894-423c-a0a9-5ec6462b1516"
      }
    }
  }
}
