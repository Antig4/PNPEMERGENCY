# PNP EmergencyLink — Environment Configuration
#
# IMPORTANT: Change this to your computer's actual LAN IP address when
# testing with a physical Android phone on the same Wi-Fi network.
#
# Find your LAN IP:
#   Windows: ipconfig (look for IPv4 Address under Wi-Fi adapter)
#   macOS/Linux: ifconfig | grep inet
#
# Then start Laravel with:
#   php artisan serve --host=0.0.0.0 --port=8000
#
# Examples:
#   Local emulator (auto-detected, no need to set):
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api
#
#   Physical phone on local network:
EXPO_PUBLIC_API_URL=http://192.168.1.29:8000/api
#
#   Production (when deployed to a server with HTTPS):
#   EXPO_PUBLIC_API_URL=https://api.pnpemergencylink.ph/api
